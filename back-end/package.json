{
  "name": "back-end",
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "npm run db:setup && tsx watch src/server.ts",
    "user:create": "npm run db:setup && tsx src/commands/create-user.ts",
    "db:seed": "npm run db:setup && prisma db seed",
    "db:setup": "docker compose up -d --wait && prisma migrate deploy && prisma generate",
    "db:stop": "docker compose stop",
    "db:migrate": "prisma migrate dev",
    "test": "prisma generate && tsc && node --test"
  },
  "devDependencies": {
    "@inquirer/prompts": "^8.7.3",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^26.6.5",
    "prisma": "^7.10.0",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2"
  },
  "dependencies": {
    "@prisma/adapter-mariadb": "^7.10.0",
    "@prisma/client": "^7.10.0",
    "bcryptjs": "^3.0.3",
    "cors": "^2.8.6",
    "dotenv": "^18.0.7",
    "express": "^5.3.0",
    "jsonwebtoken": "^9.0.3",
    "zod": "^4.6.5"
  }
}
