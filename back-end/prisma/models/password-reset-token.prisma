model PasswordResetToken {
  tokenHash   String    @id @map("token_hash") @db.Char(64)
  professorId Int       @map("professor_id")
  professor   Professor @relation(fields: [professorId], references: [id], onDelete: Cascade)
  expiresAt   DateTime  @map("expira_em")
  usedAt      DateTime? @map("usado_em")
  createdAt   DateTime  @default(now()) @map("criado_em")

  @@index([professorId])
  @@map("tokens_redefinicao_senha")
}
