# Credenciais locais usadas pelo Docker Compose na primeira inicializacao.
PORT=3000
MYSQL_ROOT_PASSWORD=troque_esta_senha_local
DB_PASSWORD=troque_esta_senha_local

# O MySQL instalado no Windows usa 3306; este container usa 3307.
DATABASE_URL="mysql://provaplus:troque_esta_senha_local@localhost:3307/provaplus"
SHADOW_DATABASE_URL="mysql://provaplus:troque_esta_senha_local@localhost:3307/provaplus_shadow"

# Crie usuarios pelo terminal com npm run user:create.
# Para criar a conta padrao local, execute npm run db:seed.
